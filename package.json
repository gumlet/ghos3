{
	"name": "@gumlet/ghos3",
	"version": "1.0.2",
	"description": "S3 Storage adapter for Ghost.",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc",
		"lint": "biome check",
		"typecheck": "tsc --noEmit",
		"lint:fix": "biome check --write",
		"prepublishOnly": "npm run build",
		"test": "echo \"Error: no test specified\" && exit 1"
	},
	"author": "Gumlet <support@gumlet.com>",
	"license": "ISC",
	"homepage": "https://github.com/gumlet/ghos3#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/gumlet/ghos3.git"
	},
	"bugs": {
		"url": "https://github.com/gumlet/ghos3/issues"
	},
	"keywords": [
		"ghost",
		"ghost-cms",
		"storage-adapter",
		"s3",
		"aws",
		"aws-sdk"
	],
	"engines": {
		"node": ">=24"
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.721.0",
		"@tryghost/errors": "^3.3.0",
		"@tryghost/tpl": "^2.3.0",
		"ghost-storage-base": "^3.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.14",
		"@types/express": "^5.0.0",
		"typescript": "^7.0.0"
	}
}
